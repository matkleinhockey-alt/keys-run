{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @keysrun/client run build",
  "build": {
    "env": {
      "VITE_API_URL": "/api",
      "VITE_SIM_WS_URL": "wss://sim-production-b2d0.up.railway.app"
    }
  },
  "outputDirectory": "apps/client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://keys-run-production.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
