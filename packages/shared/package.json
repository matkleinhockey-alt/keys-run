{
  "name": "@keysrun/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Pure, engine-independent world math and content data for Keys Run. No three.js, no DOM. See docs/ARCHITECTURE.md.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./world/chain": {
      "types": "./dist/world/chain.d.ts",
      "default": "./dist/world/chain.js"
    },
    "./world/depth": {
      "types": "./dist/world/depth.d.ts",
      "default": "./dist/world/depth.js"
    },
    "./world/current": {
      "types": "./dist/world/current.d.ts",
      "default": "./dist/world/current.js"
    },
    "./waves": {
      "types": "./dist/waves/index.d.ts",
      "default": "./dist/waves/index.js"
    },
    "./rng": {
      "types": "./dist/rng/index.d.ts",
      "default": "./dist/rng/index.js"
    },
    "./content/species": {
      "types": "./dist/content/species.d.ts",
      "default": "./dist/content/species.js"
    },
    "./content/creatures": {
      "types": "./dist/content/creatures.d.ts",
      "default": "./dist/content/creatures.js"
    },
    "./content/boats": {
      "types": "./dist/content/boats.d.ts",
      "default": "./dist/content/boats.js"
    },
    "./content/economy": {
      "types": "./dist/content/economy.d.ts",
      "default": "./dist/content/economy.js"
    },
    "./sim/boat": {
      "types": "./dist/sim/boat.d.ts",
      "default": "./dist/sim/boat.js"
    },
    "./sim/boat-shadow": {
      "types": "./dist/sim/boat-shadow.d.ts",
      "default": "./dist/sim/boat-shadow.js"
    },
    "./sim/diver": {
      "types": "./dist/sim/diver.d.ts",
      "default": "./dist/sim/diver.js"
    },
    "./sim/depth-grid": {
      "types": "./dist/sim/depth-grid.d.ts",
      "default": "./dist/sim/depth-grid.js"
    },
    "./sim/fight": {
      "types": "./dist/sim/fight.d.ts",
      "default": "./dist/sim/fight.js"
    },
    "./sim/spear": {
      "types": "./dist/sim/spear.d.ts",
      "default": "./dist/sim/spear.js"
    },
    "./proto": {
      "types": "./dist/proto/index.d.ts",
      "default": "./dist/proto/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "golden:generate": "node test/generate-golden.mjs",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
