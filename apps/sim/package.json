{
  "name": "@keysrun/sim",
  "version": "0.0.1",
  "private": true,
  "description": "Keys Run sim service (Phase 2) — 30 Hz authoritative world, interest-managed boat replication over raw ws. Singleton, vertical-scale-only. Never runs argon2. See docs/ARCHITECTURE.md.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @keysrun/shared run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @keysrun/shared run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @keysrun/shared run build",
    "test": "vitest run",
    "lint": "eslint src test",
    "load": "tsx test/load.ts"
  },
  "dependencies": {
    "@keysrun/shared": "workspace:*",
    "pg": "^8.23.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
