# Copy to apps/client/.env.local for local development (gitignored). Vite only
# exposes vars prefixed VITE_ to client code, via import.meta.env.VITE_*.
#
# NOTE (deploy agent, feat/deploy): apps/client/src does not read these two vars
# anywhere yet — there is no import.meta.env.VITE_API_URL / VITE_SIM_WS_URL call
# in the client source as of this commit. This file exists so the env var names,
# local defaults, and Vercel wiring are already settled by the time the
# networking client code lands (see docs/DEPLOYMENT.md's Vercel section for the
# production values to set in the dashboard). Until that code exists these are
# inert.

# Base URL of the apps/api HTTP service. Local default matches apps/api's own
# .env.example PORT=8080.
VITE_API_URL=http://localhost:8080

# WebSocket URL of the apps/sim service. Local default matches apps/sim's own
# .env.example PORT fallback of 8081. Use wss:// (not ws://) once deployed to
# Railway, which terminates TLS at its edge.
VITE_SIM_WS_URL=ws://localhost:8081
