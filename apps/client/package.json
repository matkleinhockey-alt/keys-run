{
  "name": "@keysrun/client",
  "version": "0.0.1",
  "private": true,
  "description": "Keys Run client app (Phase 0b) — Vite + TypeScript + three.js r128. See docs/ARCHITECTURE.md. Pinned to r128 deliberately: isolates the module port from the later r186 upgrade.",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @keysrun/shared run build",
    "dev": "vite",
    "prebuild": "pnpm --filter @keysrun/shared run build",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretest": "pnpm --filter @keysrun/shared run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@keysrun/shared": "workspace:*",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/three": "0.128.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
