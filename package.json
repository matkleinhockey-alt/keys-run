{
  "name": "keys-run",
  "version": "1.0.0",
  "private": true,
  "description": "Keys Run - center console fishing in Marathon, Florida Keys (three.js)",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "legacy": "serve -s legacy -l tcp://0.0.0.0:${PORT:-3000}",
    "start": "serve -s legacy -l tcp://0.0.0.0:${PORT:-3000}",
    "check:no-three": "node scripts/check-no-three.mjs",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @keysrun/shared run build",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @keysrun/api run db:generate",
    "db:migrate": "pnpm --filter @keysrun/api run db:migrate",
    "db:seed": "pnpm --filter @keysrun/api run db:seed"
  },
  "dependencies": {
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=18" }
}
