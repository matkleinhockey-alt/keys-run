# Copy this file to `.env` and fill in real values for local development.
# `.env` is gitignored — never commit real secrets.
#
# apps/api reads these with a zod-validated loader (apps/api/src/env.ts), so a
# missing or malformed value fails fast at boot instead of surfacing as a
# runtime error three requests later.

# --- Postgres ------------------------------------------------------------
# Must match docker-compose.yml's `postgres` service. Host port is 5433, not
# the Postgres default 5432, because 5432 is commonly already bound by another
# local Postgres instance; `docker compose up -d` publishes the container's
# 5432 onto host 5433.
POSTGRES_USER=keysrun
POSTGRES_PASSWORD=keysrun_dev_password
POSTGRES_DB=keysrun
POSTGRES_PORT=5433

# Full connection string apps/api actually connects with. Keep this in sync
# with the five POSTGRES_* values above.
DATABASE_URL=postgres://keysrun:keysrun_dev_password@localhost:5433/keysrun

# Separate database used only by `pnpm --filter @keysrun/api test` (a Vitest
# globalSetup creates + migrates this database once per run and runs real
# queries against it — see apps/api/src/test/globalSetup.ts and helpers.ts).
# Never point this at the same database as DATABASE_URL: the integration
# tests truncate all tables between every test.
TEST_DATABASE_URL=postgres://keysrun:keysrun_dev_password@localhost:5433/keysrun_test

# --- apps/api --------------------------------------------------------------
# Port the Fastify server binds on (0.0.0.0:$PORT). Railway sets PORT itself
# in production; 8080 is the local default.
PORT=8080

# Comma-separated list of origins allowed by CORS (@fastify/cors). This must
# be the deployed Vercel client origin(s) in production, e.g.
# https://keys-run.vercel.app — keep it an explicit allowlist rather than "*"
# even though auth uses a bearer token (not cookies), since this is also what
# scopes which sites may read leaderboard/me responses via the browser.
CORS_ORIGIN=http://localhost:5173

# Standard Node environment switch. Affects logger pretty-printing and
# whether stack traces are returned in error responses.
NODE_ENV=development
